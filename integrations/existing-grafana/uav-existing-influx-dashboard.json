{
  "id": null,
  "uid": "uav-existing-influx-demo",
  "title": "UAV Operations — SIMULATED DATA",
  "description": "Uses the separate UAV_Database InfluxDB datasource; measurements are synthetic.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "uav",
    "simulation"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Data source: SIMULATION",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SIMULATED UAV TELEMETRY** — Two synthetic drones generated by a separate Jenkins job. These are not flight measurements. Existing cold-chain data is not shown here."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Battery SoC",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_UAV_DATABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No fresh data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_drone_id",
          "query": "SELECT last(\"battery_soc_pct\") FROM \"uav_demo_telemetry\" WHERE $timeFilter AND time > now() - 60s AND \"source\" = 'simulation' GROUP BY \"drone_id\""
        }
      ]
    },
    {
      "id": 3,
