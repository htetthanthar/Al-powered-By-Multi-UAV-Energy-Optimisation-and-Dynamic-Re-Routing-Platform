    {
      "id": 6,
      "type": "xychart",
      "title": "Predicted vs physical power — identity reference",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_UAV_DATABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"physical_w\") AS \"physical_w\", last(\"predicted_w\") AS \"predicted_w\", last(\"ideal_w\") AS \"ideal_w\" FROM \"uav_suite_fit\" WHERE $timeFilter AND time > now() - 30s AND \"source\" = 'simulation' GROUP BY \"sample_id\"",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_UAV_DATABASE}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "No fresh data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00D9F5"
          },
          "decimals": 2,
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 6
            },
            "fillOpacity": 85,
            "lineWidth": 2,
            "axisLabel": "Predicted power (W, synthetic)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "physical_w"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "custom.axisLabel",
                "value": "Physical reference (W, synthetic)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ideal_w"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              },
              {
                "id": "custom.show",
                "value": "lines"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "mapping": "manual",
        "series": [
          {
            "name": {
              "fixed": "Predicted power (W, synthetic)"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "physical_w"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "predicted_w"
              }
            }
          },
          {
            "name": {
              "fixed": "Ideal fit"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "physical_w"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "ideal_w"
              }
            }
          }
        ]
      }
