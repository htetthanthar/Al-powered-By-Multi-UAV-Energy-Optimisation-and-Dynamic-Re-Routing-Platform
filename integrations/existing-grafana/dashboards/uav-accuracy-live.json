    {
      "id": 1,
      "type": "text",
      "title": "06 · MLP Energy Surrogate Accuracy",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SIMULATED LIVE DATA** · Accuracy is computed from each synthetic sample batch; no fixed R² claim.\n\nRefresh: 10 seconds. Statistics use fresh samples only. These are illustrative scenarios, not flight validation or measured ML gains."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Batch R²",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_UAV_DATABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"r_squared\") FROM \"uav_suite_accuracy\" WHERE $timeFilter AND time > now() - 30s AND \"source\" = 'simulation'",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_UAV_DATABASE}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No fresh data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00D9F5"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      }
    },
