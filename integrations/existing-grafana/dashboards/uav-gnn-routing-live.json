    {
      "id": 2,
      "type": "stat",
      "title": "Waypoints",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_UAV_DATABASE}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT count(\"lat\") FROM (SELECT last(\"lat\") AS \"lat\" FROM \"uav_suite_routing\" WHERE $timeFilter AND time > now() - 30s AND \"source\" = 'simulation' GROUP BY \"node_id\")",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_UAV_DATABASE}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No fresh data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00D9F5"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
