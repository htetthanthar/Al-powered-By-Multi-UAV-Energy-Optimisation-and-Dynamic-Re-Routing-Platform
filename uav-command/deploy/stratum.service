[Unit]
Description=STRATUM Singapore UAV Simulation (loopback only)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/stratum/app
ExecStart=/opt/stratum/runtime/bin/node /opt/stratum/app/server.mjs
Environment=PORT=4174
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
CPUQuota=75%
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
